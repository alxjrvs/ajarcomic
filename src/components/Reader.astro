---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { pages, pageCount, title, pageHref, endHref } from '../lib/comic';
import { pageEdge, lightness } from '../lib/edges';

interface Props { n: number }
const { n } = Astro.props;
const source = pages[n - 1]!;

const widths = [640, 960, 1280, 1600, 2000, 2400].filter((w) => w < source.width);
widths.push(source.width);

// The page is fit to the viewport, so its rendered width is whichever is
// smaller: the viewport width, or the viewport height times the aspect ratio.
const sizes = (img: ImageMetadata) =>
  `min(100vw, calc((100vh - 40px) * ${(img.width / img.height).toFixed(4)}))`;

const img = await getImage({ src: source, widths, format: 'webp' });

const prev = n === 1 ? null : pageHref(n - 1);
const next = n === pageCount ? endHref : pageHref(n + 1);

// Preload the next page so paging feels instant.
const nextSource = pages[n];
const preload = nextSource
  ? { srcset: (await getImage({ src: nextSource, widths, format: 'webp' })).srcSet.attribute, sizes: sizes(nextSource) }
  : undefined;

// Background: extend the page's own edge color(s) beyond its borders when the
// edges are clean enough to read; otherwise a neutral dark.
const edge = await pageEdge((source as { fsPath?: string }).fsPath ?? new URL(`../../comic/${source.src.split('/').pop()}`, import.meta.url).pathname);
const top = edge?.top ?? '#111111';
const bottom = edge?.bottom ?? top;
// Rendered page height: the page area, or narrower viewports' width-bound height.
const pageH = `min(100dvh - 40px, 100vw * ${(source.height / source.width).toFixed(4)})`;
const at = (f: number) => `calc(${f.toFixed(3)} * ${pageH})`;
const backdrop = edge && edge.stops.length
  ? `linear-gradient(to bottom, ${top} 0 ${at(edge.fadeFrom)}, ${edge.stops.map((s) => `${s.color} ${at(s.at)}`).join(', ')}, ${bottom} ${at(edge.fadeTo)} 100%)`
  : `linear-gradient(${top}, ${top})`;
const light = lightness(bottom) > 0.5;
---
<Base title={n === 1 ? title : `${title} — ${n}`} preload={preload}>
  <main class:list={{ light }} style={`--backdrop:${backdrop};--bottom:${bottom}`}>
    <figure>
      <img
        src={img.src}
        srcset={img.srcSet.attribute}
        sizes={sizes(source)}
        width={source.width}
        height={source.height}
        alt={`${title}, page ${n}`}
        decoding="sync"
        fetchpriority="high"
      />
      {prev && <a class="zone prev" href={prev} aria-label="Previous page"></a>}
      <a class="zone next" href={next} aria-label="Next page"></a>
    </figure>
    <nav>
      {prev ? <a href={prev} aria-label="Previous page">‹</a> : <span class="gap">‹</span>}
      <span>{n} / {pageCount}</span>
      <a href={next} aria-label="Next page">›</a>
    </nav>
  </main>
</Base>

<style>
  /* The page gets the viewport minus a fixed 40px strip for the nav. The
     backdrop gradient is sized to the page so a split lands on its seam. */
  main {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: calc(100dvh - 40px) 40px;
    justify-items: center;
    align-items: start;
    background: var(--backdrop) top / 100% calc(100dvh - 40px) no-repeat, var(--bottom);
    --fg: #777;
    --fg-hover: #eee;
  }
  main.light { --fg: #999; --fg-hover: #111; }
  figure {
    position: relative;
    display: grid;
    place-items: center;
  }
  img {
    display: block;
    max-width: 100vw;
    max-height: calc(100dvh - 40px);
    width: auto;
    height: auto;
  }
  .zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
  }
  .prev { left: 0; cursor: w-resize; }
  .next { right: 0; cursor: e-resize; }
  nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    height: 40px;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }
  nav a, nav .gap { font-size: 22px; line-height: 1; padding: 0 0.5rem; color: var(--fg); }
  nav .gap { visibility: hidden; }
  nav a:hover { color: var(--fg-hover); }
</style>

<script>
  const go = (sel: string) => {
    const a = document.querySelector<HTMLAnchorElement>(sel);
    if (a) location.href = a.href;
  };
  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'ArrowLeft') go('.zone.prev');
    if (e.key === 'ArrowRight' || e.key === ' ') go('.zone.next');
  });
  let x0 = 0, y0 = 0;
  addEventListener('touchstart', (e) => { x0 = e.touches[0]!.clientX; y0 = e.touches[0]!.clientY; }, { passive: true });
  addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0]!.clientX - x0;
    const dy = e.changedTouches[0]!.clientY - y0;
    if (Math.abs(dx) < 60 || Math.abs(dy) > Math.abs(dx)) return;
    go(dx < 0 ? '.zone.next' : '.zone.prev');
  });
</script>
