---
import { title as comicTitle } from '../lib/comic';
interface Props {
  title?: string;
  preload?: { srcset: string; sizes: string };
  /** which page this is (none for the coda), for the hand-off below */
  page?: number;
}
const { title = comicTitle, preload, page } = Astro.props;

// Ajar has one home now: the comic on alxjrvs.com. This reader stays up so
// old links keep working, but search engines are told the real page is
// there, and readers are sent on to the same page of it.
const HOME = 'https://alxjrvs.com/writing/ajar/';
const target = page && page > 1 ? `${HOME}#page-${page}` : HOME;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={HOME} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
    {preload && (
      <link rel="preload" as="image" imagesrcset={preload.srcset} imagesizes={preload.sizes} />
    )}
    <style is:global>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; margin: 0; }
      html, body { height: 100%; }
      body {
        background: #111;
        color: #bbb;
        font: 15px/1.5 system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
